rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMemberOf(groupId) {
      return signedIn()
        && exists(/databases/$(database)/documents/groups/$(groupId))
        && request.auth.uid in
          get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids;
    }

    match /users/{uid} {
      allow get: if signedIn();
      allow list: if signedIn() && request.query.limit <= 20;
      allow write: if signedIn() && request.auth.uid == uid;
    }

    match /groups/{groupId} {
      allow read: if signedIn()
        && request.auth.uid in resource.data.memberUids;
      allow create: if signedIn()
        && request.resource.data.memberUids.size() == 1
        && request.auth.uid in request.resource.data.memberUids
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.solo is bool;
      allow update: if signedIn()
        && request.auth.uid in resource.data.memberUids
        && request.auth.uid in request.resource.data.memberUids
        && (
          (
            resource.data.solo != true
            && request.resource.data.solo != true
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['memberUids'])
          )
          || (
            resource.data.solo != true
            && request.resource.data.solo != true
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['inviteCode'])
            && request.resource.data.inviteCode is string
            && request.resource.data.inviteCode.size() == 6
            && !('inviteCode' in resource.data)
          )
        );
      allow delete: if false;
    }

    match /inviteCodes/{code} {
      allow get: if signedIn();
      allow create: if signedIn()
        && request.resource.data.groupId is string
        && request.resource.data.createdByUid == request.auth.uid;
      allow list, update, delete: if false;
    }

    match /triggers/{triggerId} {
      allow read: if isMemberOf(resource.data.groupId);
      allow create: if isMemberOf(request.resource.data.groupId)
        && request.resource.data.createdByUid == request.auth.uid;
      allow update: if isMemberOf(resource.data.groupId)
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['groupId'])
          || isMemberOf(request.resource.data.groupId)
        );
      allow delete: if isMemberOf(resource.data.groupId);
    }

    match /events/{eventId} {
      allow read: if isMemberOf(resource.data.groupId);
      allow create: if isMemberOf(request.resource.data.groupId)
        && request.resource.data.triggerId is string
        && request.resource.data.triggeredByUid == request.auth.uid;
      allow update: if isMemberOf(resource.data.groupId)
        && isMemberOf(request.resource.data.groupId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['groupId']);
      allow delete: if isMemberOf(resource.data.groupId);
    }
  }
}
